# Copy to .env and edit before running `docker compose up`.
#
# On first boot the app routes you to /setup in the browser, where you
# create the super admin account. No env vars needed for that — just set
# VITRIOL_SECRET_KEY below and run the container.

# REQUIRED — long random string. Used to sign JWTs and encrypt secrets in DB.
# Changing this invalidates all sessions and makes encrypted server-settings
# secrets (SMTP password, OAuth client secrets) unreadable until re-entered.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VITRIOL_SECRET_KEY=replace-me-with-a-long-random-string

# Optional — defaults to sqlite:////data/vitriol.db.
# For Neon Postgres:
#   VITRIOL_DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/db?sslmode=require
# VITRIOL_DATABASE_URL=

# Optional — concurrency + token lifetimes.
# VITRIOL_MAX_CONCURRENT_CONVERSIONS=3
# VITRIOL_ACCESS_TOKEN_MINUTES=15
# VITRIOL_REFRESH_TOKEN_DAYS=30

# ──────────────────────────────────────────────────────────────────────────
# Optional: pre-baked super admin for fully-automated deployments
# ──────────────────────────────────────────────────────────────────────────
# Leave commented out for the normal (browser) flow. Uncomment all three
# only if you're provisioning via CI / infra-as-code and don't want a
# manual setup step. If VITRIOL_SUPERADMIN_PASSWORD is empty (the default),
# the /setup wizard runs instead.
#
# VITRIOL_SUPERADMIN_USERNAME=superadmin
# VITRIOL_SUPERADMIN_PASSWORD=
# [email protected]

# ──────────────────────────────────────────────────────────────────────────
# SSO is configured AFTER setup by the super admin in the Server tab.
# Supported providers:
#   - Google
#   - GitHub
#   - Generic OpenID Connect — works with Authentik, Keycloak, Auth0, Okta,
#     Zitadel, or any OIDC-compliant IdP. Just paste the issuer URL +
#     client id/secret. The redirect URI to register with your IdP is:
#         <PUBLIC_BASE_URL>/api/v1/auth/sso/oidc/callback
